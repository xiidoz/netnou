{
  "name": "netnou",
  "version": "0.6.0",
  "description": "Live public-transport map: vehicle positions computed from GTFS and GTFS-Realtime feeds, routes between stops from OpenStreetMap. No runtime dependencies.",
  "keywords": [
    "gtfs",
    "gtfs-realtime",
    "public-transport",
    "transit",
    "live-map",
    "openstreetmap",
    "maplibre"
  ],
  "homepage": "https://github.com/xiidoz/netnou#readme",
  "bugs": {
    "url": "https://github.com/xiidoz/netnou/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiidoz/netnou.git"
  },
  "license": "MIT",
  "author": "The Netnou contributors",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "build:icons": "node tools/build-icons.mjs",
    "build:social": "node tools/build-social-preview.mjs",
    "build:area": "node tools/build-vgn-area.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7"
  }
}
